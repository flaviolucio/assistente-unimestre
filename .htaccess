Options -Indexes
RewriteEngine On

# ---------------------------------------------------------------------------
# Hardening: o DocumentRoot do XAMPP é C:/xampp/htdocs, portanto a raiz do
# projeto fica exposta. Tudo que não é public/ (ou o front controller) é
# bloqueado aqui antes de qualquer outra regra.
# ---------------------------------------------------------------------------

# Arquivos ocultos/sensíveis em qualquer nível (.env, .env.*, .git, .htaccess...)
RewriteRule (^|/)\. - [F,L]

# Diretórios internos da aplicação
RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|node_modules)(/|$) - [F,L]

# Documentação, relatórios, logs e artefatos
RewriteRule ^(README|RELATORIO)[^/]*$ - [F,NC,L]
RewriteRule \.(md|log|sql|bak|zip|gz|tmp|ini|lock|dist|jar)$ - [F,NC,L]

# Dentro de public/ somente o front controller e assets são servidos diretamente
RewriteRule ^public/assets/.*\.(php\d?|phtml|phar|phps)$ - [F,NC,L]

RewriteRule ^assets/(.*)$ public/assets/$1 [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/index.php [QSA,L]

# Segunda camada (não depende do mod_rewrite)
<FilesMatch "(^\.|\.(env|md|log|sql|bak|ini|lock)$)">
    Require all denied
</FilesMatch>
