APP_NAME="Central Inteligente de Suporte UNIMESTRE"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/assistente-unimestre
APP_KEY=
# APP_ENCRYPTION_KEY: chave mestre para criptografar credenciais de providers de IA.
# Gere com: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"  (64 caracteres hexadecimais).
# Se for perdida/alterada, a API Key existente nao podera mais ser descriptografada.
APP_ENCRYPTION_KEY=
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=assistente_unimestre
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=

AI_DEFAULT_PROVIDER=openrouter
AI_TIMEOUT_SECONDS=30
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

RAG_MAX_CONTEXT_CHARS=12000
RAG_CHUNK_SIZE_CHARS=1800
RAG_CHUNK_OVERLAP_CHARS=200
# top_k e score mínimo do retrieval: padrão em config/knowledge.php;
# override administrativo em system_settings (rag.top_k, rag.min_score).

LOG_LEVEL=debug
LOG_DAYS_TO_KEEP=30

SESSION_NAME=assistente_unimestre
SESSION_LIFETIME=7200

AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_ATTEMPT_WINDOW_MINUTES=15
AUTH_PASSWORD_MIN_LENGTH=8
